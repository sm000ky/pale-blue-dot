# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Working directories that must never be published.
#
# .raw/ holds the originals the WebP plates were converted from, and — more
# importantly — .raw/rights-review/, which is where the five Golden Record frames
# with third-party rights holders are kept precisely BECAUSE they are not published.
# Committing them would put copyrighted scans in the repository, which is the thing
# the whole three-state rights model in exploration/content.ts exists to prevent.
# .raw/audio-review/ holds the unused track whose licence could not be verified.
.raw/

# Screenshots and probe scripts from browser verification runs. Evidence, not source.
.verify/
